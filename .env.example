# Copy to `.env` and edit values as needed:
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d

# External port to bind on the host. Container always listens on 8000.
# Ignored if you front the service with Traefik (see optional block below).
HOST_PORT=8000

# Image tag. Useful if you push tagged images to a registry.
IMAGE_TAG=latest

# Runtime container name.
CONTAINER_NAME=cube-solver

# Where the build pulls the lookup-table tarball from. Override to point
# at your own HTTP-serving box, or set to empty to fall back to
# dwalton76's public S3 bucket as an emergency bootstrap.
TABLES_TARBALL_URL=https://assets.jack-kaplan.com/projects/rubiks-cube/lookup-tables.tar.gz

# --- Optional: Traefik / authentik front door -----------------------------
# Only used when the Traefik block in compose.yaml is uncommented.
# Public hostname Traefik routes to this service.
#CUBE_HOST=cube.example.com

# Traefik entrypoint name (typically `web` for :80 or `websecure` for :443,
# matching what your traefik static config declares).
#TRAEFIK_ENTRYPOINT=web

# Traefik middleware chain applied to the router. Set to a middleware that
# always passes (e.g. one defined as a no-op in your traefik file provider)
# if you want this service unauthenticated — there is no "disable" syntax.
#TRAEFIK_AUTH_MIDDLEWARE=authentik@file

# Name of the external Docker network Traefik is attached to.
#TRAEFIK_PROXY_NETWORK=proxy
