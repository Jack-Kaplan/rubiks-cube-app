# Copy to `.env` and edit values as needed:
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d

# External port to bind on the host. Container always listens on 8000.
HOST_PORT=8000

# Image tag. Useful if you push tagged images to a registry.
IMAGE_TAG=latest

# Runtime container name.
CONTAINER_NAME=cube-solver

# Where the build pulls the lookup-table tarball from. Override to point
# at your own HTTP-serving box, or set to empty to fall back to
# dwalton76's public S3 bucket as an emergency bootstrap.
TABLES_TARBALL_URL=https://assets.jack-kaplan.com/projects/rubiks-cube/lookup-tables.tar.gz
